# Copie para .env e preencha. Nunca versione o .env.
# Todas as chaves são opcionais: o SIGAA Simulado não exige nenhuma.

# --- Groq (IA) ---
GROQ_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# ID numérico do chat privado que receberá as notificações
TELEGRAM_CHAT_ID=
# ID numérico do seu usuário (único autorizado a usar comandos)
TELEGRAM_USER_ID=

# --- Interface web (sigaa-sim web) ---
# Opcional. Se definido, a interface exige este token (tela de acesso). Recomendado se
# você expuser o servidor fora de 127.0.0.1. Gere com: python -c "import secrets;print(secrets.token_urlsafe(24))"
WEB_TOKEN=
